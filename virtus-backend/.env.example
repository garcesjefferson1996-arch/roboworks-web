# Copia este archivo a .env y completa con tus valores reales.
# NUNCA subas el archivo .env real a git.

# Entorno
NODE_ENV=development
PORT=4000

# Dominios permitidos (separados por coma) - front de producción y desarrollo local
FRONTEND_URL_PROD=https://plataforma.virtusrobotica.com
FRONTEND_URL_DEV=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Cookies de sesión
# En producción: COOKIE_DOMAIN debe ser tu dominio real (ej. .virtusrobotica.com)
# En desarrollo: dejar vacío (se usa localhost automáticamente)
COOKIE_DOMAIN=

# Base de datos MySQL (usa un plan administrado, NO un free tier, para 2000+ estudiantes)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=virtus_db
# Súbelo según el límite de conexiones que permita tu plan de MySQL (deja margen, no uses el 100%)
DB_CONNECTION_LIMIT=20

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Solo se usa temporalmente al rotar JWT_SECRET (ver comentario en
# src/middleware/auth.js). Vacío en operación normal.
JWT_SECRET_PREVIOUS=

# Cloudinary (archivos y fotos de perfil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
